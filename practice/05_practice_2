const int LED_PIN = 7;

void setup() {
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  // 1) LED on for 1 second
  digitalWrite(LED_PIN, HIGH);
  delay(1000);

  // 2) Blink 5 times within the next 1 second (100ms on, 100ms off each)
  for (int i = 0; i < 5; i++) {
    digitalWrite(LED_PIN, HIGH);
    delay(100);
    digitalWrite(LED_PIN, LOW);
    delay(100);
  }

  // 3) Turn LED off, then stop forever
  digitalWrite(LED_PIN, LOW);
  while (1) {} // infinite loop
}
