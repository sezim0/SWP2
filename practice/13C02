#include <Servo.h>

// Arduino pin assignment
#define PIN_SERVO 10

// configurable parameters (calibrated values)
#define _DUTY_MIN 540   // servo full clock-wise position (0 degree)
#define _DUTY_NEU 1470  // servo neutral position (90 degree) = (MIN + MAX) / 2
#define _DUTY_MAX 2400  // servo full counter-clockwise position (180 degree)

// start / end of the sweep.
// The lecture code used a 100 usec margin from the limits. Here the sweep uses the
// full calibrated range so that 180 degree takes exactly 180 / _SERVO_SPEED seconds.
#define _POS_START (_DUTY_MIN)
#define _POS_END   (_DUTY_MAX)


#define _SERVO_SPEED 3.0 // servo speed limit (unit: degree/second)
#define INTERVAL 20      // servo update interval (unit: msec)

// global variables
unsigned long last_sampling_time; // unit: msec

Servo myservo;

// float on purpose: at these speeds the change per interval is below 1 usec
// (about 0.62 usec at 3 deg/s and 0.062 usec at 0.3 deg/s). An int would truncate it to 0.
float duty_change_per_interval; // maximum duty difference per interval
float duty_target;              // Target duty time
float duty_curr;                // Current duty time

// long: toggle_interval is 30000 for 0.3 deg/s, too close to the int limit (32767)
long toggle_interval, toggle_interval_cnt;

void setup() {
  // initialize GPIO pins
  myservo.attach(PIN_SERVO);

  duty_target = duty_curr = _POS_START;
  myservo.writeMicroseconds((int)(duty_curr + 0.5));

  // initialize serial port
  Serial.begin(57600);

  // convert angular speed into duty change per interval.
  // (_SERVO_SPEED / 180) and (INTERVAL / 1000) must be float divisions,
  // otherwise both become 0 and the servo never moves.
  duty_change_per_interval =
    (_DUTY_MAX - _DUTY_MIN) * (_SERVO_SPEED / 180.0) * (INTERVAL / 1000.0);

  Serial.print("duty_change_per_interval:");
  Serial.println(duty_change_per_interval, 4);

  // initialize variables for servo update.
  toggle_interval = (180.0 / _SERVO_SPEED) * 1000 / INTERVAL;
  toggle_interval_cnt = toggle_interval;

  // initialize last sampling time
  last_sampling_time = 0;
}

void loop() {
  // wait until next sampling time.
  if (millis() < (last_sampling_time + INTERVAL))
    return;

  // adjust duty_curr toward duty_target by duty_change_per_interval
  if (duty_target > duty_curr) {
    duty_curr += duty_change_per_interval;
    if (duty_curr > duty_target)
      duty_curr = duty_target;
  } else {
    duty_curr -= duty_change_per_interval;
    if (duty_curr < duty_target)
      duty_curr = duty_target;
  }

  // update servo position (writeMicroseconds() takes an integer)
  myservo.writeMicroseconds((int)(duty_curr + 0.5));

  // output the read value to the serial port
  Serial.print("Min:");           Serial.print(_DUTY_MIN);
  Serial.print(",duty_target:");  Serial.print(duty_target);
  Serial.print(",duty_curr:");    Serial.print(duty_curr);
  Serial.print(",Max:");          Serial.println(_DUTY_MAX);

  // toggle duty_target between _POS_START and _POS_END.
  if (toggle_interval_cnt >= toggle_interval) {
    toggle_interval_cnt = 0;
    if (duty_target == _POS_START)
      duty_target = _POS_END;
    else
      duty_target = _POS_START;
  } else {
    toggle_interval_cnt++;
  }

  // update last sampling time
  last_sampling_time += INTERVAL;
}
